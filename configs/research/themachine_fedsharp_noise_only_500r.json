{
  "schema": 1,
  "description": "18 fresh 500-round noise-only controls on themachine. Prefer GPUs 1 and 3; GPUs 0 and 2 join after low-utilization and live memory checks.",
  "settings": {
    "datasets": ["mnist", "cifar10"],
    "partitions": ["IID", "nonIID"],
    "seeds": [2025, 2026, 2027],
    "families": ["sharp"],
    "environments": ["noise_only"],
    "nodes": 100,
    "rounds": 500,
    "local_steps": 5,
    "sigma": 0.01,
    "alpha": 0.5,
    "gpu_count": 4,
    "gpus": "1,3,0,2",
    "gpu_memory_mib": 3072,
    "ram_mib_per_worker": 8192,
    "ram_headroom_mib": 16384,
    "max_workers_per_gpu": 24,
    "scheduler": "shared",
    "poll_seconds": 3
  }
}
