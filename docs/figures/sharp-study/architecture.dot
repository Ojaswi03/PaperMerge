digraph SHARP {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.5", fontname="DejaVu Sans", label="SHARP + CART: one receiver activation in a 100-client ring", labelloc=t, fontsize=20];
  node [shape=box, style="rounded,filled", fillcolor="#edf3fa", color="#26435f", fontname="DejaVu Sans", fontsize=12, margin="0.15,0.1"];
  edge [color="#53677b", arrowsize=0.8, fontname="DejaVu Sans", fontsize=10];
  incoming [label="Up to 66 predecessor copies\nLatest version per sender\nIndependent per-link Gaussian noise"];
  screen [label="Peak screen on a full window\nDeviation from coordinate median\nLog all-fail fallback"];
  rank [label="Rank by raw local CE\nKeep up to q = 33\nAverage the selected copies"];
  train [label="Five local SGD steps\nCE + hop-aware gradient penalty\n+ frozen proximal anchor"];
  cart [label="Optional CART\nClass-gated reference outputs\nRidge correction in current features\nSeparate private check", fillcolor="#e1f3ee", color="#157966"];
  attack [label="Outbound attack, if enabled\nThen fresh noise per receiver\nSend to next 66 clients", fillcolor="#fff0e6", color="#af5b23"];
  data [label="Receiver's private TRAIN pictures", shape=folder, fillcolor="#f6f7e9"];
  memory [label="Receiver-owned older whole model\nPrivate fitting and check probes\n19-draw channel allowance", fillcolor="#e1f3ee", color="#157966"];
  holdout [label="Separate TRAIN holdout\nRound reporting only", fillcolor="#f5f5f5", color="#666666"];
  incoming -> screen -> rank -> train -> cart -> attack;
  train -> attack [label="CART off", style=dashed];
  data -> rank [label="same batch as first SGD step"];
  data -> train;
  memory -> cart;
  cart -> holdout [style=dotted, label="committed model evaluated"];
  train -> holdout [style=dotted, label="no-CART model evaluated"];
}
