digraph FedCAD {
  graph [rankdir=TB, bgcolor="white", pad=.25, nodesep=.35, ranksep=.45];
  node [shape=box, style="rounded,filled", fillcolor="#eef4ff", color="#355478", fontname="DejaVu Sans", fontsize=12];
  edge [color="#526277", fontname="DejaVu Sans", fontsize=10];
  server [label="SERVER\nGlobal teacher model", fillcolor="#fff4d9"];
  aux [label="Auxiliary labeled examples\nEstimate teacher's true-class probability"];
  weights [label="Class weights\nalpha_y = beta + (gamma - beta) E[p_teacher(y)]"];
  clients [label="Selected CLIENTS\nInitialize from server model"];
  loss [label="Local SGD\n(1 - alpha_y) label CE + alpha_y teacher distillation"];
  local [label="Trained client models"];
  average [label="SERVER weighted model aggregation", fillcolor="#fff4d9"];
  server -> aux -> weights;
  server -> clients; weights -> clients; clients -> loss -> local -> average;
  average -> server [label="next round", constraint=false];
}
