digraph ACIL {
  graph [rankdir=TB, bgcolor="white", pad=.25, nodesep=.35, ranksep=.45];
  node [shape=box, style="rounded,filled", fillcolor="#eef4ff", color="#355478", fontname="DejaVu Sans", fontsize=12];
  edge [color="#526277", fontname="DejaVu Sans", fontsize=10];
  base [label="Base-class data\nTrain CNN representation"];
  frozen [label="Freeze representation\nFixed random feature expansion", fillcolor="#fff4d9"];
  new [label="New-class data at phase k"];
  features [label="Features H_k in the SAME fixed map"];
  stats [label="Previous sufficient statistics\nFeature correlations and classifier state"];
  update [label="Recursive analytic update\nEquivalent to accumulated batch ridge solution"];
  classifier [label="Updated classifier\nClass columns expand", fillcolor="#e1f3e5"];
  caveat [label="Memorization equivalence concerns analytic weights\nIt does NOT mean 100% classification accuracy", fillcolor="#ffe9e5"];
  base -> frozen -> features; new -> features; features -> update; stats -> update;
  update -> classifier -> caveat;
  update -> stats [label="retain statistics; next phase", constraint=false];
}
