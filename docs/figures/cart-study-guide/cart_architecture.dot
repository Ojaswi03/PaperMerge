digraph CART {
  graph [rankdir=TB, bgcolor="white", pad=.25, nodesep=.3, ranksep=.4];
  node [shape=box, style="rounded,filled", fillcolor="#eef4ff", color="#355478", fontname="DejaVu Sans", fontsize=12, margin=.15];
  edge [color="#526277", fontname="DejaVu Sans", fontsize=10];
  incoming [label="Five predecessor snapshots"];
  basil [label="BASIL selection\nReceiver-local raw cross-entropy"];
  train [label="Full selected-model handoff\nFive complete local SGD / EBM epochs"];
  proposal [label="Newly trained proposal\nBackbone + classifier"];
  teacher [label="Receiver-owned whole reference\nPrivate class fitting probes", fillcolor="#fff4d9"];
  allowance [label="19 modeled channel corruptions\nClass loss allowances", fillcolor="#fff4d9"];
  gates [label="Class controller\nReference advantage / (advantage + allowance)"];
  solve [label="Balanced residual transport\n65 x 65 ridge solve in CURRENT features", fillcolor="#e1f3e5"];
  select [label="Separate local selection probes\nChoose strength including ZERO"];
  commit [label="Committed model\nOnly classifier corrected; proposal backbone retained", fillcolor="#e1f3e5"];
  outgoing [label="Scheduled outbound Hidden corruption\nTHEN independent per-link Gaussian noise", fillcolor="#ffe9e5"];
  next [label="Refresh next five memories\nActivate immediate successor next"];
  incoming -> basil -> train -> proposal -> solve -> select -> commit -> outgoing -> next;
  teacher -> allowance -> gates;
  teacher -> gates;
  proposal -> gates;
  gates -> solve;
  teacher -> solve [label="reference logits"];
  commit -> teacher [style=dashed, label="admit whole reference when fitting macro CE improves", constraint=false];
}
