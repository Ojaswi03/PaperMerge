digraph Transport {
  graph [rankdir=TB, bgcolor="white", pad=.25, nodesep=.4, ranksep=.45];
  node [shape=box, style="rounded,filled", fillcolor="#eef4ff", color="#355478", fontname="DejaVu Sans", fontsize=12];
  edge [color="#526277", fontname="DejaVu Sans", fontsize=10];
  images [label="Same private fitting images"];
  old [label="Stored whole reference\nOld feature extractor and head", fillcolor="#fff4d9"];
  oldlogits [label="Reference logits"];
  backbone [label="Proposal backbone\nAlready adapted by ordinary SGD", fillcolor="#e1f3e5"];
  features [label="Current features H\n64 coordinates"];
  current [label="Proposal logits\nH W + b"];
  target [label="Centered, class-gated\nREFERENCE minus PROPOSAL logits"];
  ridge [label="Fit residual in [H, 1] coordinates\nBalanced ridge regression"];
  head [label="Corrected classifier\nW + alpha Delta_W; b + alpha Delta_b", fillcolor="#e1f3e5"];
  output [label="Current features + corrected classifier\nNo old latent-vector copying"];
  images -> old -> oldlogits -> target;
  images -> backbone -> features -> current -> target;
  features -> ridge [label="design matrix"];
  target -> ridge -> head -> output;
  features -> output [label="backbone unchanged during repair"];
}
