{
  "schema": 1,
  "description": "12 fresh base FedSharp clean controls: IID mu=0 and nonIID mu=1; MNIST/CIFAR-10, three seeds, 500 rounds. No FedSharp+ and no checkpoint continuation.",
  "settings": {
    "datasets": ["mnist", "cifar10"],
    "partitions": ["IID", "nonIID"],
    "seeds": [2025, 2026, 2027],
    "families": ["sharp"],
    "environments": ["clean"],
    "nodes": 100,
    "rounds": 500,
    "local_steps": 5,
    "sigma": 0.01,
    "alpha": 0.5,
    "gpu_count": 2,
    "gpu_memory_mib": 3072,
    "ram_mib_per_worker": 8192,
    "ram_headroom_mib": 16384,
    "max_workers_per_gpu": 24,
    "scheduler": "shared",
    "poll_seconds": 3
  }
}
